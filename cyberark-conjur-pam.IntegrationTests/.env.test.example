CONJUR_URL=http://conjur.example.com
CONJUR_ACCOUNT_ID=conjurAccountName
CONJUR_LOGIN=conjurLogin
CONJUR_VARIABLE_PATH=id/variableName

CONJUR_EXPECTED_SECRET_VALUE=expectedSecretValue # Used to validate retrieved secret

CONJUR_API_KEY=yourapikey # Optional if using password authentication
CONJUR_PASSWORD=conjurPassword # Required if CONJUR_API_KEY is not set